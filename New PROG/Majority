import java.util.*;
class Patter{
    public static int mjority(int[] nums){
       int count=0,mj=nums[0];
       for(int i=0;i<nums.length;i++){
           if(count==0){
               mj=nums[i];
               count++;}
           else if(mj==nums[i])
               count++;
           else
               count--;}
       return mj;}
public static void main(String[] args) {
        int[] nums={2,2,2,1,1,2,2};
        System.out.println(mjority(nums));}}
