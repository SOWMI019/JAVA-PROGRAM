import java.util.*;
class Pattern{
    static Scanner d=new Scanner(System.in);
    public static String Binarysearch(int[] arr,int search){
            int first=0;
            int last=arr.length-1;
            while(first<=last){
                int mid=(first+last)/2;
            if(search==arr[mid])
                return "Element found";
            else if(search>arr[mid])
                first=mid+1;
            else
                last=mid-1;
        }
        return "element not found";
    }
    public static void main(String[] args){
        int n=d.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<arr.length;i++){
            arr[i]=d.nextInt();
        }
        int search=d.nextInt();
        System.out.println(Binarysearch(arr,search));
    }}
