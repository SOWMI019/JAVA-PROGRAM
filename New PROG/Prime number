import java.util.*;
class Pratice{
    static Scanner d=new Scanner(System.in);
    public static String isPrime(int num){
        int count=0;
        if(num==0 && num==1)
            return "Not prime";
            for(int i=2;i<=num/2;i++) {
                if (num % i == 0)
                    count++;}
           if(count>1)
               return "not prime";
           else
               return "Prime";}
        public static void main(String[] args) {
        System.out.print("Enter the n value:");
        int n=d.nextInt();
        System.out.println(isPrime(n));}}
