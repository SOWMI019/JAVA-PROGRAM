import java.util.*;
class Pattern{
    static Scanner d=new Scanner(System.in);
    public static String LinearSearch(int[] a,int search){
        for(int i=0;i<a.length;i++){
            if(search==a[i])
                return "element found";
        }
        return "element not found";
    }
    public static void main(String[] args){
        int n=d.nextInt();
        int[] a=new int[n];
        for(int i=0;i<a.length;i++){
            a[i]=d.nextInt();}
            int search=d.nextInt();
            System.out.println(LinearSearch(a,search));
        }}
}}
