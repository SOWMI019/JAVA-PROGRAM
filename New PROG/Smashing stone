import java.util.*;
class Pattern{
    static Scanner d=new Scanner(System.in);
    public static int SmashStone(int[] arr){
        int n=arr.length;
        while(n>1) {
            Arrays.sort(arr, 0, n);
            int x = arr[n - 1];
            int y = arr[n - 2];
            if (x == y)
                n -= 2;
            else {
                arr[n - 2] = x - y;
                n -= 1;}}
            return n==1?arr[0]:0; //1 }
    public static void main(String[] args) {
        int n = d.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < arr.length; i++) {
            arr[i] = d.nextInt();//[ 2 7 4 1 8 1]}
        System.out.println(SmashStone(arr));}}
