import java.util.*;
class  Pattern{
    public static void main(String[] args){
        int[] m={1,2,3,4};
        int[] n={5,6,7,8};
        int[] res=new int[m.length+n.length];
        for(int i=0,p=0,r=0;i<res.length;i++){
                res[i]=m[p++];
            else
                res[i]=n[r++];}
