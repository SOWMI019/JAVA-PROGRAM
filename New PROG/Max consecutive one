import java.util.*;
class Solutio{
        static Scanner d=new Scanner(System.in);
        public static int MxConsecutive(int[] nums){
                int count=0,mx=0;
                for(int i=0;i<nums.length;i++) {
                        if (nums[i] == 1)
                                count++;
                        else
                                count = 0;
                                if(count>mx){
                        mx=count; }}
                return mx;}
        public static void main(String[] args){
                int n=d.nextInt();
                int[] nums=new int[n];
                for(int i=0;i<nums.length;i++){
                        nums[i]=d.nextInt();}
                System.out.println("Result:" +MxConsecutive(nums));}}
